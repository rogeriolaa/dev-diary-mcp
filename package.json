{
  "name": "dev-diary-mcp",
  "version": "1.1.0",
  "description": "MCP server that turns a folder of Markdown files into a searchable work journal for any LLM",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "dev-diary-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx src/e2e-check.ts",
    "start": "node dist/server.js",
    "demo": "node dist/demo-client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogeriolaa/dev-diary-mcp.git"
  },
  "keywords": [
    "mcp",
    "ai",
    "journal",
    "markdown",
    "llm",
    "claude"
  ]
}
